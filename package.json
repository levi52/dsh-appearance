{
  "name": "dsh-appearance",
  "version": "0.1.0",
  "description": "Appearance settings plugin for the dsh web profile: theme presets (Claude / GitHub / Neo-brutalism / Terminal) plus font family, code font and font-size controls, persisted in the host settings document.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "~18.3.1",
    "react": "18.2.0",
    "typescript": "~5.6.3"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node build.mjs",
    "install-plugin": "node scripts/install.mjs",
    "uninstall-plugin": "node scripts/uninstall.mjs"
  },
  "license": "MIT"
}
